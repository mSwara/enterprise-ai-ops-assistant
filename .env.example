# LLM Provider
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_ai_db
# Used by docker-compose.yml to set the Postgres container's password —
# keep this in sync with the password portion of DATABASE_URL above.
POSTGRES_PASSWORD=your_db_password_here

# Vector DB
VECTOR_DB_PATH=./data/vector_store

# App
ENV=development
LOG_LEVEL=INFO

# LangSmith (optional — leave LANGSMITH_TRACING=false to disable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=enterprise-ai-ops-assistant